# Production: public API origin (no trailing slash)
# VITE_API_BASE=https://api.example.com
#
# Required for auth UI (publishable pk_ key only — never sk_):
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional tip jar. Publishable key only (pk_) — anything else is ignored and the
# coffee button stays hidden. The matching API needs STRIPE_SECRET_KEY (see root .env.example):
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
