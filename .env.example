# Brisbane Parking Finder — no secrets required for local development.
#
# Place BCC CSVs under data/ (see data/README.md), then:
#   make ingest && make api
#
# API (optional; read by api/py/server.py):
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# CORS_ORIGINS=https://your-site.netlify.app
# RATE_LIMIT_PER_MIN=600
# MAX_BBOX_SPAN_DEG=0.5
# BPF_ENV=production
#
# Supporter payments (optional; all off unless STRIPE_SECRET_KEY is set):
# Prefer a restricted key (rk_) limited to Checkout Sessions write over a full sk_ key.
# STRIPE_SECRET_KEY=rk_test_...              # server-side only — never expose to the browser
# STRIPE_WEBHOOK_SECRET=whsec_...            # from the Stripe webhook endpoint for /api/support/webhook
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# SUPPORT_AMOUNT_CENTS=500                   # default 500
# SUPPORT_CURRENCY=aud                       # default aud
# SUPPORT_PRODUCT_NAME=Brisbane Parking supporter coffee
#
# Ports are fixed at 8080 API / 5173 Vite unless you change the code.
